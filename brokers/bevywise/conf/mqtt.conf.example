# Bevywise MQTTRoute / CrystalMQ – mqtt.conf, Ausschnitt fuer das ENETEC-Lab.

TOPIC_ACL = TRUE                   # [DOK] Client-ID-/Username-basierte Topic-ACL einschalten
# ACHTUNG [DOK]: Mit TOPIC_ACL = TRUE sind laut Bevywise ALLE Topics erlaubt, solange fuer
# eine Client-ID / einen Username keine Regel existiert. Das ist KEIN Deny-by-default.
# Folge fuer die Abnahme: ACL-06 (Topic ausserhalb jedes Namespace) und ACL-13 (unbekanntes
# Gateway) werden voraussichtlich FAIL, solange es keinen globalen Deny-Default gibt.
# Klaeren: globaler Default "deny" moeglich? Sonst Custom-Hook oder Deny-Regel je Identitaet.

# Session-Persistenz / Clean Start = false (SES-01) und Verhalten bei doppelter Client-ID
# (DUP-01): Schluessel OFFEN, Standardverhalten wird vom Harness gemessen.
